# Copy this file to `.env` and fill in your values.
# Without AWS credentials the app still runs in built-in DEMO mode.

# AWS region where your Bedrock models are enabled (us-east-1 is a good default)
AWS_REGION=us-east-1

# AWS credentials (IAM user with bedrock:InvokeModel permission).
# Never commit the real .env file — it is git-ignored.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional: leave empty to use the default Claude Haiku model.
BEDROCK_MODEL_ID=us.anthropic.claude-3-5-haiku-20241022-v1:0

# Port for the local server
PORT=3000
